{
  "manifest_version": 3,
  "name": "GhostText: Cyber Defense v4",
  "version": "4.0",
  "description": "Prevents sensitive data leaks in AI chatbots by detecting and redacting PII, secrets, and logs blocked events locally.",
  "permissions": ["storage", "notifications", "clipboardRead"],
  "icons": {
    "16": "logo.svg",
    "48": "logo.svg",
    "128": "logo.svg"
  },
  "action": {
    "default_popup": "panel.html",
    "default_icon": "logo.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
